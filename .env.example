# Backend API (swap Hugging Face endpoint with your backend without frontend changes)
VITE_API_URL=https://api.atsscorer.io/v1

# Hugging Face Model
VITE_HF_MODEL_URL=https://api-inference.huggingface.co/models/your-username/ats-scorer
VITE_HF_TOKEN=hf_your_token_here

VITE_CHATGPT_API=your_chatgpt_api_key_here

# Supabase Configuration
# Use the API URL (Settings -> API -> Project URL), NOT the dashboard URL.
VITE_SUPABASE_URL=https://<your-project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Email (your own mail — no Supabase Edge Functions) ──────────────────────
# Sender address shown on outgoing mail
VITE_MAIL_FROM=ATS Scanner <you@yourdomain.com>

# OPTION A (recommended): your own backend endpoint that sends the email.
# Keeps OAuth secrets server-side. POST { from, to, subject, html }.
VITE_MAIL_API_URL=

# OPTION B (works from the browser, recommended without a backend): EmailJS.
# Create a free account at emailjs.com, connect your Gmail as a "service",
# make a template with variables: to_email, subject, message, from_name.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# OPTION C: Gmail OAuth2 direct from the browser (refresh + access tokens).
# ⚠️ DOES NOT WORK from a browser — Google's token endpoint blocks browser
# requests (CORS), so token refresh fails. Kept for a future backend only.
VITE_GMAIL_CLIENT_ID=
VITE_GMAIL_CLIENT_SECRET=
VITE_GMAIL_REFRESH_TOKEN=
VITE_GMAIL_ACCESS_TOKEN=